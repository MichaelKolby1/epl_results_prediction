__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
build/
dist/
# Data from third-party sites is packaged in local-review ZIP only.
data/raw/*
!data/raw/.gitkeep
outputs/*
!outputs/.gitkeep

# Review-only third-party-derived reference dataset
data/reference/*.xlsx
data/processed/*
!data/processed/.gitkeep
